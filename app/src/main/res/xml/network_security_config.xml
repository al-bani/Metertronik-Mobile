<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mengizinkan HTTP (cleartext) untuk development -->
    <!-- HAPUS atau ubah ke HTTPS untuk production! -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

